# Copy this file to .env and replace the placeholder values.
# Never commit .env.

# Used by the db service to create the database on first start
POSTGRES_USER=pinpage
POSTGRES_PASSWORD=pinpage
POSTGRES_DB=pinpage

# Used by the api service. The user, password and database name must match
# the values above. The host is "db", the name of the database service.
DATABASE_URL=postgresql://pinpage:pinpage@db:5432/pinpage

# Secret used to sign login tokens. Generate a long random value for real use, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
# How long a login token stays valid, in minutes
JWT_EXPIRE_MINUTES=30

# Cloudflare R2, where original PDFs are stored. All four are required: the
# app refuses to start without them. Put your real keys in .env only; never
# in this file, a commit or a prompt.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=pinpage-dev

# Upload limits: the largest file in MB (at most 100), and how many
# processing or ready documents a workspace may hold (failed ones don't count)
MAX_UPLOAD_MB=20
MAX_DOCUMENTS_PER_WORKSPACE=10
# Longest document in pages; a longer one fails with too_many_pages
MAX_PAGES=100
# How long a signed link to an original PDF stays valid, in seconds
SIGNED_URL_SECONDS=300
# A document still processing this long after its upload (or retry) is marked
# failed (interrupted) at startup
PROCESSING_TIMEOUT_MINUTES=15

# Chunking: about this many characters per chunk, and how many characters
# neighbouring chunks share (must be smaller than CHUNK_SIZE)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# The AI, through OpenRouter. Get a key at https://openrouter.ai/keys and put
# it in .env only. Without it, documents fail with ai_unavailable.
OPENROUTER_API_KEY=your-openrouter-key
AI_BASE_URL=https://openrouter.ai/api/v1
# A specific free chat model. Avoid openrouter/free: it can route chat to a
# safety classifier that answers "User Safety: safe" instead of replying.
AI_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Chat models tried in order if AI_CHAT_MODEL can't answer (comma separated)
AI_CHAT_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free
AI_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Size of each embedding. Must match the database column (set by the
# migration), so only change it together with a new migration.
EMBEDDING_DIMENSIONS=2048
# Give up on one AI request after this many seconds
AI_TIMEOUT_SECONDS=45
# Upper limit on the length of each AI reply
AI_MAX_TOKENS=1000
# Chunks per embedding request, and AI requests a minute at most (OpenRouter
# allows 20 a minute on free models). The free daily allowance is shared by
# everything on your OpenRouter account, including the live ShopAssist demo.
EMBEDDING_BATCH_SIZE=64
AI_REQUESTS_PER_MINUTE=15

# LangSmith tracing is never used: the app refuses to start if
# LANGCHAIN_TRACING_V2, LANGSMITH_TRACING (or their variants) is true
